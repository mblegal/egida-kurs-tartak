<!DOCTYPE html>
<!--
  Kurs tartakowy EGIDA — template główny kursu self-study.
  Template z placeholderami podmienianymi przez generator build-kurs.mjs (Task 3.8).
  Języki: ES (default widoczny), UK, EN, PL (przełączalne przez lang-switcher).
-->
<html lang="es" data-current-lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{COURSE_NAME_ES}} — {{MODULE_NAME_ES}}</title>

  <!-- Google Fonts: Inter (sans) + Plus Jakarta Sans (display). Inter ma cyrylicę — wystarcza dla UK. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

  <!-- CSS modułowo: design tokens + karty + style kursu. W finalnej wersji standalone (dist/) wszystko pójdzie inline. -->
  <link rel="stylesheet" href="../styles/design-tokens.css">
  <link rel="stylesheet" href="../styles/cards.css">
  <link rel="stylesheet" href="../styles/kurs.css">
</head>
<body>
  <!-- Overlay mobilny (Step 7) — widoczny tylko gdy sidebar jest otwarty na ≤1024px -->
  <div class="sidebar-overlay" aria-hidden="true"></div>

  <div class="app-container">

    <!-- =====================================================================
         SIDEBAR — logo, language switcher, progress, nawigacja tygodni
         ===================================================================== -->
    <aside id="course-sidebar" class="sidebar" aria-label="Navegación del curso">

      <!-- Logo blok -->
      <div class="sidebar__logo">
        <div class="sidebar__logo-mark" aria-hidden="true">TARTAK</div>
        <div class="sidebar__logo-subtitle">
          <span data-lang="es">{{COURSE_NAME_ES}}</span>
          <span data-lang="uk" hidden>{{COURSE_NAME_UK}}</span>
          <span data-lang="en" hidden>{{COURSE_NAME_EN}}</span>
          <span data-lang="pl" hidden>{{COURSE_NAME_PL}}</span>
        </div>
      </div>

      <!-- Language switcher — statyczny wygląd. Interakcja = Step 4. -->
      <!-- TODO Step 4: podłączyć onclick -> toggle hidden po data-lang, set html[lang] i data-current-lang -->
      <nav class="lang-switcher" aria-label="Language selector">
        <button type="button" class="lang-btn lang-btn--active" data-lang-target="es" aria-pressed="true">ES</button>
        <button type="button" class="lang-btn" data-lang-target="uk" aria-pressed="false">UK</button>
        <button type="button" class="lang-btn" data-lang-target="en" aria-pressed="false">EN</button>
        <button type="button" class="lang-btn" data-lang-target="pl" aria-pressed="false">PL</button>
      </nav>

      <!-- Progress bar — statycznie 0%. Podłączenie logiki = Step 5. -->
      <!-- TODO Step 5: procent i width fill liczone z COURSE.progress w localStorage -->
      <div class="progress">
        <div class="progress__header">
          <span class="progress__label">
            <span data-lang="es">Progreso</span>
            <span data-lang="uk" hidden>Прогрес</span>
            <span data-lang="en" hidden>Progress</span>
            <span data-lang="pl" hidden>Postęp</span>
          </span>
          <span class="progress__value">0%</span>
        </div>
        <div class="progress__bar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
          <div class="progress__fill" style="width: 0%;"></div>
        </div>
      </div>

      <!-- Nawigacja 4 tygodni — generowana z content/${MODULE_ID}/structure.json -->
      <nav class="weeks-nav" aria-label="Lista de lecciones">
{{SIDEBAR_WEEKS_HTML}}
      </nav>

      <!-- Przycisk otwierający końcowy quiz modułu (Step 6) -->
      <button type="button" class="final-quiz-open">
        <span data-lang="es">🏆 Examen final del módulo</span>
        <span data-lang="uk" hidden>🏆 Підсумковий іспит модуля</span>
        <span data-lang="en" hidden>🏆 Final module exam</span>
        <span data-lang="pl" hidden>🏆 Egzamin końcowy modułu</span>
      </button>

    </aside>

    <!-- =====================================================================
         MAIN CONTENT — wrapper na wszystkie <article.lesson> + final quiz view
         ===================================================================== -->
    <main class="main-content" aria-label="Contenido de la lección">

      <!-- Breadcrumb / nagłówek pasek -->
      <header class="content-header">
        <!-- Hamburger mobile (Step 7) — widoczny tylko na ≤1024px -->
        <button type="button" class="menu-toggle" aria-label="Menú" aria-controls="course-sidebar" aria-expanded="false">☰</button>
        <div class="breadcrumb" aria-label="breadcrumb">
          <span data-lang="es">{{BREADCRUMB_ES}}</span>
          <span data-lang="uk" hidden>{{BREADCRUMB_UK}}</span>
          <span data-lang="en" hidden>{{BREADCRUMB_EN}}</span>
          <span data-lang="pl" hidden>{{BREADCRUMB_PL}}</span>
        </div>
      </header>

      <!-- =====================================================================
           Wrapper treści lekcji. Jedna <article.lesson> na każdą lekcję;
           widoczna jest tylko ta z data-lesson-id pasującym do aktywnej pozycji
           w sidebarze. Generator build-kurs.mjs wstawia 32 artykuły (4×8).
           ===================================================================== -->
      <div class="lesson-content-wrapper">

      <!-- ============ Lekcje wygenerowane z content/${MODULE_ID}/lessons/**
           (w tym placeholdery dla lekcji bez plików .md). ===================== -->
{{LESSONS_HTML}}
      <!-- /lekcje -->

      </div><!-- /.lesson-content-wrapper -->

      <!-- =====================================================================
           FINAL QUIZ VIEW — generowany przez build-kurs.mjs z content/${MODULE_ID}/quizzes.json
           (lub placeholder gdy brak pliku). Widok ukryty domyślnie — JS pokazuje go po kliknięciu .final-quiz-open
           ===================================================================== -->
{{FINAL_QUIZ_HTML}}

      <!-- Nawigacja dół lekcji -->
      <!-- TODO Step 5: podłączyć routing lekcji (prev/next na podstawie indeksu) -->
      <nav class="lesson-nav" aria-label="Navegación entre lecciones">
        <button type="button" class="lesson-nav__btn lesson-nav__btn--prev" disabled aria-disabled="true">
          <span data-lang="es">← Lección anterior</span>
          <span data-lang="uk" hidden>← Попередній урок</span>
          <span data-lang="en" hidden>← Previous lesson</span>
          <span data-lang="pl" hidden>← Poprzednia lekcja</span>
        </button>
        <button type="button" class="lesson-nav__btn lesson-nav__btn--next">
          <span data-lang="es">Lección siguiente →</span>
          <span data-lang="uk" hidden>Наступний урок →</span>
          <span data-lang="en" hidden>Next lesson →</span>
          <span data-lang="pl" hidden>Następna lekcja →</span>
        </button>
      </nav>

    </main>

  </div>

  <!-- =====================================================================
       JS runtime kursu — cały w jednym bloku na końcu <body>, bez zależności.
       Sekcje: [Step 4] lang-switcher · [Step 5] nav/progress/mini-quiz ·
       [Step 6] końcowy quiz · [Step 7] hamburger mobile.
       ===================================================================== -->
  <script>
    (function () {
      'use strict';

      // ---------------------------------------------------------------
      // Stałe + klucze localStorage (wspólne dla wszystkich sekcji)
      // ---------------------------------------------------------------
      var SUPPORTED_LANGS = ['es', 'uk', 'en', 'pl'];
      var DEFAULT_LANG = 'es';
      var LS_LANG = 'egida_tartak_lang';
      var LS_PROGRESS = 'egida_tartak_{{MODULE_ID}}_progress';
      var LS_QUIZ = 'egida_tartak_{{MODULE_ID}}_quizResult';
      var TOTAL_LESSONS = 32; // 4 tygodnie × 8 lekcji w M1
      var PASS_THRESHOLD = 70; // procent

      // Feedback mini-quizu w 4 językach (krótki tekst — reszta UI zostaje w HTML).
      var UI_FEEDBACK = {
        es: { correct: '✅ ¡Correcto!', incorrect: '❌ Inténtalo de nuevo' },
        uk: { correct: '✅ Правильно!', incorrect: '❌ Спробуй ще раз' },
        en: { correct: '✅ Correct!',   incorrect: '❌ Try again' },
        pl: { correct: '✅ Dobrze!',    incorrect: '❌ Spróbuj jeszcze raz' }
      };

      // Teksty wyniku końcowego quizu
      var UI_RESULT = {
        es: { passed: '✅ ¡Aprobado!', failed: '❌ No aprobado', scoreLabel: 'Tu puntuación:',
              retake: 'Intentar de nuevo', backToCourse: 'Volver al curso' },
        uk: { passed: '✅ Склав!',     failed: '❌ Не склав',    scoreLabel: 'Твій результат:',
              retake: 'Спробувати знову', backToCourse: 'Повернутися до курсу' },
        en: { passed: '✅ Passed!',    failed: '❌ Not passed',  scoreLabel: 'Your score:',
              retake: 'Try again', backToCourse: 'Back to course' },
        pl: { passed: '✅ Zdane!',     failed: '❌ Niezaliczone', scoreLabel: 'Twój wynik:',
              retake: 'Spróbuj ponownie', backToCourse: 'Powrót do kursu' }
      };

      function getCurrentLang() {
        return document.documentElement.dataset.currentLang || DEFAULT_LANG;
      }

      // ---------------------------------------------------------------
      // STEP 4 — Przełącznik języka (UI + persistencja)
      // ---------------------------------------------------------------

      function setLanguage(lang) {
        if (SUPPORTED_LANGS.indexOf(lang) === -1) return;

        // Toggle `hidden` na wszystkich elementach treści z data-lang.
        // Przyciski języka używają `data-lang-target`, więc nie łapią się,
        // ale dla bezpieczeństwa wykluczamy też `.lang-btn`.
        var langNodes = document.querySelectorAll('[data-lang]:not(.lang-btn)');
        langNodes.forEach(function (node) {
          if (node.getAttribute('data-lang') === lang) {
            node.removeAttribute('hidden');
          } else {
            node.setAttribute('hidden', '');
          }
        });

        // Update stanu przycisków lang-switcher
        document.querySelectorAll('.lang-btn').forEach(function (btn) {
          var isActive = btn.getAttribute('data-lang-target') === lang;
          btn.classList.toggle('lang-btn--active', isActive);
          btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });

        // Update atrybutów <html>
        document.documentElement.setAttribute('lang', lang);
        document.documentElement.dataset.currentLang = lang;

        // Persystencja
        try { localStorage.setItem(LS_LANG, lang); } catch (e) {}
      }

      function initLanguageSwitcher() {
        // Event delegation na całym switcherze — odporne na ewentualną
        // przyszłą zmianę liczby przycisków (gdyby doszedł np. 5. język).
        var switcher = document.querySelector('.lang-switcher');
        if (switcher) {
          switcher.addEventListener('click', function (e) {
            var btn = e.target.closest('.lang-btn');
            if (!btn) return;
            var lang = btn.getAttribute('data-lang-target');
            if (lang) setLanguage(lang);
          });
        }

        // Init: spróbuj odczytać zapisaną preferencję.
        // Jeśli brak / nieznany język — zostawiamy stan domyślny z markup'u (ES).
        var stored = null;
        try { stored = localStorage.getItem(LS_LANG); } catch (e) {}
        if (stored && SUPPORTED_LANGS.indexOf(stored) !== -1) {
          setLanguage(stored);
        }
      }

      // ---------------------------------------------------------------
      // STEP 5 — Nawigacja lekcji + progress + mini-quiz
      // ---------------------------------------------------------------

      // Lista wszystkich ID lekcji w kolejności sidebara (dla prev/next)
      function getAllLessonIds() {
        var items = document.querySelectorAll('.lesson-item[data-lesson-id]');
        var ids = [];
        items.forEach(function (item) { ids.push(item.getAttribute('data-lesson-id')); });
        return ids;
      }

      function loadProgress() {
        try {
          var raw = localStorage.getItem(LS_PROGRESS);
          return raw ? JSON.parse(raw) : {};
        } catch (e) { return {}; }
      }

      function saveProgress(progress) {
        try {
          localStorage.setItem(LS_PROGRESS, JSON.stringify(progress));
          var completed = 0;
          getAllLessonIds().forEach(function (id) { if (progress[id]) completed++; });
          localStorage.setItem('egida-progress:{{MODULE_ID}}', JSON.stringify({
            completed: completed,
            total: TOTAL_LESSONS
          }));
        } catch (e) {}
      }

      function updateProgressBar() {
        var progress = loadProgress();
        var completed = 0;
        getAllLessonIds().forEach(function (id) { if (progress[id]) completed++; });
        var pct = Math.round((completed / TOTAL_LESSONS) * 100);

        var fill  = document.querySelector('.progress__fill');
        var value = document.querySelector('.progress__value');
        var bar   = document.querySelector('.progress__bar');
        if (fill)  fill.style.width = pct + '%';
        if (value) value.textContent = pct + '%';
        if (bar)   bar.setAttribute('aria-valuenow', String(pct));
      }

      function refreshSidebarCompletedFlags() {
        var progress = loadProgress();
        document.querySelectorAll('.lesson-item[data-lesson-id]').forEach(function (item) {
          var id = item.getAttribute('data-lesson-id');
          item.classList.toggle('lesson-item--completed', !!progress[id]);
        });
      }

      function markLessonComplete(id) {
        if (!id) return;
        var progress = loadProgress();
        if (progress[id]) return;
        progress[id] = true;
        saveProgress(progress);
        refreshSidebarCompletedFlags();
        updateProgressBar();
      }

      // Format data-lesson-id: "m{module}-w{week}-l{lesson}"
      function parseLessonId(id) {
        var m = /^m(\d+)-w(\d+)-l(\d+)$/.exec(id || '');
        if (!m) return null;
        return { module: +m[1], week: +m[2], lesson: +m[3] };
      }

      function updateBreadcrumb(id) {
        var parsed = parseLessonId(id);
        if (!parsed) return;
        var labels = {
          es: 'Módulo '  + parsed.module + ' / Semana '   + parsed.week + ' / Lección ' + parsed.lesson,
          uk: 'Модуль '  + parsed.module + ' / Тиждень '  + parsed.week + ' / Урок '    + parsed.lesson,
          en: 'Module '  + parsed.module + ' / Week '     + parsed.week + ' / Lesson '  + parsed.lesson,
          pl: 'Moduł '   + parsed.module + ' / Tydzień '  + parsed.week + ' / Lekcja '  + parsed.lesson
        };
        var bc = document.querySelector('.breadcrumb');
        if (!bc) return;
        bc.querySelectorAll('[data-lang]').forEach(function (n) {
          var lang = n.getAttribute('data-lang');
          if (labels[lang]) n.textContent = labels[lang];
        });
      }

      function goToLesson(id) {
        if (!id) return;

        // 1. Aktywna pozycja w sidebarze
        document.querySelectorAll('.lesson-item[data-lesson-id]').forEach(function (item) {
          var isActive = item.getAttribute('data-lesson-id') === id;
          item.classList.toggle('lesson-item--active', isActive);
          if (isActive) item.setAttribute('aria-current', 'page');
          else          item.removeAttribute('aria-current');
        });

        // 2. Pokaż właściwy <article> — realna lekcja (m1-w1-l1) lub placeholder
        var wrapper = document.querySelector('.lesson-content-wrapper');
        if (!wrapper) return;
        var articles = wrapper.querySelectorAll('article.lesson');
        var realMatched = null;
        var placeholder = null;
        articles.forEach(function (a) {
          var aid = a.getAttribute('data-lesson-id');
          if (aid === '__placeholder__') placeholder = a;
          else if (aid === id)           realMatched = a;
        });

        articles.forEach(function (a) { a.setAttribute('hidden', ''); });
        if (realMatched) {
          realMatched.removeAttribute('hidden');
        } else if (placeholder) {
          placeholder.removeAttribute('hidden');
        }

        // 3. Breadcrumb + przyciski prev/next
        updateBreadcrumb(id);
        updateLessonNavButtons(id);

        // 4. Scroll do góry + zamknij sidebar na mobile (Step 7)
        window.scrollTo({ top: 0, behavior: 'smooth' });
        closeSidebarMobile();
      }

      function updateLessonNavButtons(currentId) {
        var ids = getAllLessonIds();
        var idx = ids.indexOf(currentId);
        var prev = document.querySelector('.lesson-nav__btn--prev');
        var next = document.querySelector('.lesson-nav__btn--next');

        if (prev) {
          if (idx <= 0) {
            prev.setAttribute('disabled', '');
            prev.setAttribute('aria-disabled', 'true');
          } else {
            prev.removeAttribute('disabled');
            prev.removeAttribute('aria-disabled');
          }
        }
        if (next) {
          if (idx === -1 || idx >= ids.length - 1) {
            next.setAttribute('disabled', '');
            next.setAttribute('aria-disabled', 'true');
          } else {
            next.removeAttribute('disabled');
            next.removeAttribute('aria-disabled');
          }
        }
      }

      function getCurrentLessonId() {
        var active = document.querySelector('.lesson-item.lesson-item--active[data-lesson-id]');
        return active ? active.getAttribute('data-lesson-id') : null;
      }

      function initLessonNavigation() {
        // Event delegation na .weeks-nav — klik w pozycję lekcji
        var weeksNav = document.querySelector('.weeks-nav');
        if (weeksNav) {
          weeksNav.addEventListener('click', function (e) {
            var item = e.target.closest('.lesson-item[data-lesson-id]');
            if (!item) return;
            goToLesson(item.getAttribute('data-lesson-id'));
          });
        }

        // Przyciski prev / next (bezpośrednie listenery — są tylko dwa)
        var prev = document.querySelector('.lesson-nav__btn--prev');
        var next = document.querySelector('.lesson-nav__btn--next');
        if (prev) {
          prev.addEventListener('click', function () {
            var ids = getAllLessonIds();
            var idx = ids.indexOf(getCurrentLessonId());
            if (idx > 0) goToLesson(ids[idx - 1]);
          });
        }
        if (next) {
          next.addEventListener('click', function () {
            var ids = getAllLessonIds();
            var cur = getCurrentLessonId();
            var idx = ids.indexOf(cur);
            // Klik „Następna lekcja" = uznaj bieżącą za ukończoną.
            if (cur) markLessonComplete(cur);
            if (idx !== -1 && idx < ids.length - 1) goToLesson(ids[idx + 1]);
          });
        }

        // Init — progress bar, flagi completed, stan przycisków
        refreshSidebarCompletedFlags();
        updateProgressBar();
        var cur = getCurrentLessonId();
        if (cur) updateLessonNavButtons(cur);
      }

      // --- Mini-quiz — inline sprawdzenie pojedynczego pytania ---
      function initMiniQuiz() {
        // Event delegation na .main-content — odporne na przełączanie lekcji.
        var root = document.querySelector('.main-content');
        if (!root) return;

        root.addEventListener('click', function (e) {
          var opt = e.target.closest('.mini-quiz__option');
          if (!opt) return;

          var question = opt.closest('.mini-quiz__question');
          if (!question) return;
          if (question.dataset.answered === 'true') return; // pytanie już rozwiązane

          var isCorrect = opt.getAttribute('data-correct') === 'true';

          question.dataset.answered = 'true';
          question.querySelectorAll('.mini-quiz__option').forEach(function (o) {
            o.classList.add('mini-quiz__option--locked');
            // Zawsze podświetl poprawną — żeby user wiedział, która była dobra.
            if (o.getAttribute('data-correct') === 'true') {
              o.classList.add('mini-quiz__option--correct');
            }
          });
          if (!isCorrect) opt.classList.add('mini-quiz__option--incorrect');

          // Feedback tekstowy — generujemy spany w 4 językach i pokazujemy
          // tylko bieżący (pozostałe z `hidden`). Spójne z resztą szablonu.
          var fb = document.createElement('div');
          fb.className = 'mini-quiz__feedback ' +
            (isCorrect ? 'mini-quiz__feedback--correct' : 'mini-quiz__feedback--incorrect');
          var cur = getCurrentLang();
          SUPPORTED_LANGS.forEach(function (l) {
            var s = document.createElement('span');
            s.setAttribute('data-lang', l);
            s.textContent = isCorrect ? UI_FEEDBACK[l].correct : UI_FEEDBACK[l].incorrect;
            if (l !== cur) s.setAttribute('hidden', '');
            fb.appendChild(s);
          });
          question.appendChild(fb);
        });
      }

      // ---------------------------------------------------------------
      // STEP 6 — Końcowy quiz modułu
      // ---------------------------------------------------------------
      function showFinalQuiz() {
        var wrapper = document.querySelector('.lesson-content-wrapper');
        var quizView = document.querySelector('.final-quiz-view');
        var nav = document.querySelector('.lesson-nav');
        if (wrapper)  wrapper.setAttribute('hidden', '');
        if (nav)      nav.setAttribute('hidden', '');
        if (quizView) quizView.removeAttribute('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function backToCourse() {
        var wrapper = document.querySelector('.lesson-content-wrapper');
        var quizView = document.querySelector('.final-quiz-view');
        var nav = document.querySelector('.lesson-nav');
        if (wrapper)  wrapper.removeAttribute('hidden');
        if (nav)      nav.removeAttribute('hidden');
        if (quizView) quizView.setAttribute('hidden', '');
        // Przy wyjściu przywracamy widok pytania/submit (gdyby ktoś wracał po submicie)
        var resultEl = document.querySelector('.final-quiz-result');
        if (resultEl) resultEl.setAttribute('hidden', '');
        var questions = document.querySelector('.final-quiz-questions');
        var submit = document.querySelector('.final-quiz-submit');
        if (questions) questions.removeAttribute('hidden');
        if (submit)    submit.removeAttribute('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function retakeFinalQuiz() {
        var form = document.querySelector('.final-quiz-form');
        if (form) form.reset();
        var resultEl = document.querySelector('.final-quiz-result');
        if (resultEl) resultEl.setAttribute('hidden', '');
        var questions = document.querySelector('.final-quiz-questions');
        var submit = document.querySelector('.final-quiz-submit');
        if (questions) questions.removeAttribute('hidden');
        if (submit)    submit.removeAttribute('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function submitFinalQuiz() {
        var form = document.querySelector('.final-quiz-form');
        if (!form) return;
        var questions = form.querySelectorAll('.final-quiz-question');
        var total = questions.length;
        var correct = 0;
        var answers = window.__finalQuizAnswers || {};
        questions.forEach(function (q, idx) {
          var selected = q.querySelector('input[type="radio"]:checked');
          var qid = 'q' + (idx + 1);
          if (selected && selected.value === answers[qid]) correct++;
        });
        var pct = total > 0 ? Math.round((correct / total) * 100) : 0;
        var passed = pct >= PASS_THRESHOLD;

        // Zapisz ostatni wynik (bez historii — nadpisuje poprzedni)
        try {
          localStorage.setItem(LS_QUIZ, JSON.stringify({
            score: pct, correct: correct, total: total, passed: passed,
            date: new Date().toISOString()
          }));
        } catch (e) {}

        renderFinalQuizResult(pct, correct, total, passed);
      }

      function renderFinalQuizResult(pct, correct, total, passed) {
        var resultEl = document.querySelector('.final-quiz-result');
        if (!resultEl) return;

        // Schowaj pytania + submit — pokazujemy tylko wynik
        var questionsBlock = document.querySelector('.final-quiz-questions');
        var submit = document.querySelector('.final-quiz-submit');
        if (questionsBlock) questionsBlock.setAttribute('hidden', '');
        if (submit)         submit.setAttribute('hidden', '');
        resultEl.removeAttribute('hidden');

        // Zbuduj świeży widok wyniku w 4 językach
        resultEl.innerHTML = '';
        var cur = getCurrentLang();

        SUPPORTED_LANGS.forEach(function (l) {
          var wrap = document.createElement('div');
          wrap.setAttribute('data-lang', l);
          if (l !== cur) wrap.setAttribute('hidden', '');

          var h = document.createElement('h2');
          h.className = 'final-quiz-result__title ' +
            (passed ? 'final-quiz-result__title--passed' : 'final-quiz-result__title--failed');
          h.textContent = passed ? UI_RESULT[l].passed : UI_RESULT[l].failed;
          wrap.appendChild(h);

          var p = document.createElement('p');
          p.className = 'final-quiz-result__score';
          p.textContent = UI_RESULT[l].scoreLabel + ' ' + correct + '/' + total + ' (' + pct + '%)';
          wrap.appendChild(p);

          var actions = document.createElement('div');
          actions.className = 'final-quiz-result__actions';

          var retakeBtn = document.createElement('button');
          retakeBtn.type = 'button';
          retakeBtn.className = 'final-quiz-result__btn final-quiz-result__btn--retake';
          retakeBtn.textContent = UI_RESULT[l].retake;
          retakeBtn.addEventListener('click', retakeFinalQuiz);
          actions.appendChild(retakeBtn);

          var backBtn = document.createElement('button');
          backBtn.type = 'button';
          backBtn.className = 'final-quiz-result__btn final-quiz-result__btn--back';
          backBtn.textContent = UI_RESULT[l].backToCourse;
          backBtn.addEventListener('click', backToCourse);
          actions.appendChild(backBtn);

          wrap.appendChild(actions);
          resultEl.appendChild(wrap);
        });
      }

      function initFinalQuiz() {
        var openBtn = document.querySelector('.final-quiz-open');
        if (openBtn) {
          openBtn.addEventListener('click', function () {
            showFinalQuiz();
            closeSidebarMobile(); // na mobile po otwarciu quizu chowamy sidebar
          });
        }

        var form = document.querySelector('.final-quiz-form');
        if (form) {
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            submitFinalQuiz();
          });
        }

        var backBtn = document.querySelector('.final-quiz-back');
        if (backBtn) backBtn.addEventListener('click', backToCourse);
      }

      // ---------------------------------------------------------------
      // STEP 7 — Hamburger mobile (≤1024px)
      // ---------------------------------------------------------------
      function openSidebarMobile() {
        var sidebar = document.querySelector('.sidebar');
        var overlay = document.querySelector('.sidebar-overlay');
        var toggle  = document.querySelector('.menu-toggle');
        if (sidebar) sidebar.classList.add('sidebar--open');
        if (overlay) overlay.classList.add('sidebar-overlay--visible');
        if (toggle)  toggle.setAttribute('aria-expanded', 'true');
      }

      function closeSidebarMobile() {
        var sidebar = document.querySelector('.sidebar');
        var overlay = document.querySelector('.sidebar-overlay');
        var toggle  = document.querySelector('.menu-toggle');
        if (sidebar) sidebar.classList.remove('sidebar--open');
        if (overlay) overlay.classList.remove('sidebar-overlay--visible');
        if (toggle)  toggle.setAttribute('aria-expanded', 'false');
      }

      function initMobileMenu() {
        var toggle = document.querySelector('.menu-toggle');
        var overlay = document.querySelector('.sidebar-overlay');
        if (toggle) {
          toggle.addEventListener('click', function () {
            var sidebar = document.querySelector('.sidebar');
            if (!sidebar) return;
            if (sidebar.classList.contains('sidebar--open')) closeSidebarMobile();
            else openSidebarMobile();
          });
        }
        if (overlay) overlay.addEventListener('click', closeSidebarMobile);
      }

      // ---------------------------------------------------------------
      // Boot
      // ---------------------------------------------------------------
      function init() {
        initLanguageSwitcher();
        initLessonNavigation();
        initMiniQuiz();
        initFinalQuiz();
        initMobileMenu();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</body>
</html>
