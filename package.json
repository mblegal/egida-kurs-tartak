    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "vitest": "^2.1.0",
    "puppeteer": "^23.0.0"
  }
