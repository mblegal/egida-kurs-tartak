{
  "name": "egida-kurs-tartak",
  "version": "0.1.0",
  "description": "Kurs tartakowy Fundacji EGIDA — materiały 4-językowe (PL/EN/ES/UK)",
  "type": "module",
  "private": true,
  "scripts": {
    "build:kurs": "node generator/build-kurs.mjs",
    "build:prezentacja": "node generator/build-prezentacja.mjs",
    "build:docs": "node generator/build-docs.mjs",
    "build:prospekt": "node generator/build-prospekt.mjs",
